{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wuxuai-restaurant-bonus-app-staging-v2",
  "main": "./worker/staging-v2-access.mjs",
  "compatibility_date": "2026-07-15",
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "WUXUAI_APP_ORIGIN": "https://staging-v2.bonus.wuxuaisbi.com",
    "WUXUAI_ACCESS_ISSUER": "https://REPLACE_WITH_TEAM.cloudflareaccess.com",
    "WUXUAI_ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD"
  }
}
